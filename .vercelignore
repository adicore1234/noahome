# לזהות אותו כשרת Node ולהפסיק לפרסם את קובצי ה-static (באג התמונות החסרות).
local-server.js

# קבצי סביבה מקומיים — לעולם לא להעלות
.env
*.env

# פלט בנייה מקומי — הבילד ב-Vercel מייצר אותו מחדש
dist/

# קבצי עבודה מקומיים
.playwright-mcp/
.video_agent/
